  "type": "function",
  "z": "avarma_tab",
  "name": "Werte einzeln",
  "func": "// zerlegt avarma/state in einzelne Nachrichten (z. B. fuer Dashboard/InfluxDB)\nconst out = [];\nfor (const [k, v] of Object.entries(msg.payload)) {\n  if (v !== null && typeof v !== 'object') out.push({ topic: 'avarma/wert/' + k, payload: v });\n}\nnode.status({ text: `VL ${msg.payload.vl} RL ${msg.payload.rl} WW ${msg.payload.ww} Aussen ${msg.payload.ta}` });\nreturn [out];",
  "outputs": 1,
  "x": 360,
