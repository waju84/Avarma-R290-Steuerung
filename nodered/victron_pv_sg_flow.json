 {
  "id": "tick1",
  "type": "inject",
  "z": "avarma_tab",
  "name": "jede Minute",
  "props": [
   {
    "p": "topic",
    "vt": "str"
   }
  ],
  "repeat": "60",
  "crontab": "",
  "once": true,
  "onceDelay": "5",
  "topic": "tick",
  "x": 150,
  "y": 340,
  "wires": [
   [
    "sg_fn"
   ]
  ]
 },
 {
  "id": "sg_fn",
  "type": "function",
  "z": "avarma_tab",
  "name": "PV -> SG-Ready",
  "func": "// ===== Einstellungen =====\nconst PV_ON     = 2500;    // W: ab dieser PV-Leistung SG aktivieren ...\nconst PV_OFF    = 1500;    // W: ... und darunter wieder auf SG2\nconst SOC_MIN   = 90;      // % Batterie mindestens (ohne Batterie: 0 eintragen)\nconst ON_DELAY  = 10 * 60; // s so lange muss es passen, bevor eingeschaltet wird\nconst OFF_DELAY = 10 * 60; // s so lange darunter, bevor ausgeschaltet wird\nconst SG_ON     = 3;       // 3 = erst WP bis 60 C, dann Heizstab; 4 = WP + Heizstab gleichzeitig\n// ==========================\n\nlet st = context.get('st') || { pv: 0, soc: 100, sg: 2, cand: 2, since: Date.now() };\nif (msg.topic === 'pv')  st.pv  = Number(msg.payload) || 0;\nif (msg.topic === 'soc') st.soc = Number(msg.payload) || 0;\n\nconst now = Date.now();\nlet want = st.cand;\nif (st.pv >= PV_ON && st.soc >= SOC_MIN) want = SG_ON;\nelse if (st.pv < PV_OFF || st.soc < SOC_MIN - 5) want = 2;\nif (want !== st.cand) { st.cand = want; st.since = now; }\n\nconst delay = (st.cand === 2 ? OFF_DELAY : ON_DELAY) * 1000;\nlet changed = false;\nif (st.cand !== st.sg && now - st.since >= delay) { st.sg = st.cand; changed = true; }\ncontext.set('st', st);\n\nnode.status({ fill: st.sg === 2 ? 'grey' : 'green', shape: 'dot',\n              text: `PV ${Math.round(st.pv)} W, SOC ${st.soc} %, SG${st.sg}` });\n\n// jede Minute wiederholen (sonst faellt der ESP nach 15 min auf SG2 zurueck)\nif (msg.topic === 'tick' || changed) return { topic: 'avarma/cmd/sg', payload: String(st.sg) };\nreturn null;",
  "outputs": 1,
  "x": 380,
  "y": 300,
  "wires": [
   [
    "out_cmd"
   ]
  ]
 },
