 {
  "id": "rt_fn",
  "type": "function",
  "z": "avarma_tab",
  "name": "Raum-Regler (PI)",
  "func": "// ===== Einstellungen =====\nconst RT_SOLL  = 21.0;  // C Wohnzimmer\nconst VL_BASIS = 32;    // C VL, wenn die Raumtemperatur genau passt (Startwert)\nconst KP       = 4;     // K VL je K Raumabweichung\nconst KI       = 0.5;   // K VL je K Abweichung und Stunde\nconst VL_MIN   = 25, VL_MAX = 45;\n// ==========================\n\nlet s = context.get('s') || { rt: null, i: 0, last: Date.now() };\nif (msg.topic === 'rt') { s.rt = Number(msg.payload); context.set('s', s); return null; }\nif (msg.topic !== 'tick' || s.rt === null || isNaN(s.rt)) return null;\n\nconst now = Date.now();\nconst h = (now - s.last) / 3600000;\ns.last = now;\nconst e = RT_SOLL - s.rt;\ns.i = Math.max(-8, Math.min(8, s.i + KI * e * h));\nlet vl = Math.round(VL_BASIS + KP * e + s.i);\nvl = Math.max(VL_MIN, Math.min(VL_MAX, vl));\ncontext.set('s', s);\nnode.status({ text: `RT ${s.rt.toFixed(1)} / ${RT_SOLL} C -> VL ${vl} C` });\nreturn { topic: 'avarma/cmd/vl', payload: String(vl) };",
  "outputs": 1,
  "x": 380,
  "y": 460,
  "wires": [
   [
    "out_cmd"
   ]
  ],
  "d": true
 },
