 {
  "id": "pvd_fn",
  "type": "function",
  "z": "avarma_tab",
  "name": "Victron -> PV-Daten",
  "func": "// Sammelt die Werte der Victron-Knoten und schickt sie an den ESP (Display \"PV\")\n// und an \"PV -> SG-Ready\". Jeder Victron-Knoten bekommt als NAME einen dieser Schluessel:\n//   pv_dc            System: MPPTs - power (W)              (alle MPPTs zusammen)\n//   pv_ac_L1..L3     System: PV - AC-coupled on input/output Lx (nur bei PV-Wechselrichter)\n//   soc              System: Battery State of Charge (%)\n//   bat              System: Battery Power (W)              (+ = laden)\n//   grid_L1..L3      System: Grid Lx (W)                    (+ = Bezug)\n//   house_L1..L3     System: AC Consumption Lx (W)\n//   today_1, today_2 ...       Solar Charger: Yield today (kWh)      (je MPPT ein Knoten)\n//   yesterday_1, yesterday_2   Solar Charger: Yield yesterday (kWh)\n// Gleiche Anfaenge werden addiert (L1+L2+L3, mehrere MPPTs).\nconst name = String(msg.topic || '').trim();\nlet v = msg.payload;\nif (v !== null && typeof v === 'object' && 'value' in v) v = v.value;\nv = Number(v);\nif (!name || !isFinite(v)) return null;\n\nconst vals = context.get('vals') || {};\nvals[name] = v;\ncontext.set('vals', vals);\n\nconst sum = (...pre) => {\n  let s = null;\n  for (const [k, x] of Object.entries(vals))\n    if (pre.some(p => k === p || k.startsWith(p + '_'))) s = (s || 0) + x;\n  return s;\n};\nconst out = {\n  power: sum('pv_dc', 'pv_ac'),\n  soc: sum('soc'), bat: sum('bat'), grid: sum('grid'), house: sum('house'),\n  today: sum('today'), yesterday: sum('yesterday')\n};\n\n// an den ESP: je Wert hoechstens alle 10 s, grosse Aenderungen sofort\nconst last = context.get('last') || {};\nconst now = Date.now();\nconst toEsp = [];\nfor (const [k, x] of Object.entries(out)) {\n  if (x === null) continue;\n  const l = last[k];\n  const step = k === 'soc' ? 1 : (k === 'today' || k === 'yesterday') ? 0.1 : 300;\n  if (l && now - l.t < 10000 && Math.abs(x - l.v) < step) continue;\n  if (l && l.v === x && now - l.t < 60000) continue;\n  last[k] = { v: x, t: now };\n  const dec = (k === 'today' || k === 'yesterday') ? 2 : 0;\n  toEsp.push({ topic: 'avarma/pv/' + k, payload: x.toFixed(dec) });\n}\ncontext.set('last', last);\n\n// an PV -> SG-Ready\nconst toSg = [];\nif (out.power !== null && (name.startsWith('pv_'))) toSg.push({ topic: 'pv', payload: out.power });\nif (name === 'soc') toSg.push({ topic: 'soc', payload: v });\n\nnode.status({ text: `PV ${out.power ?? '-'} W  SOC ${out.soc ?? '-'} %  Netz ${out.grid ?? '-'} W` });\nreturn [toEsp, toSg];",
  "outputs": 2,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 650,
  "y": 1000,
  "wires": [
   [
    "out_cmd"
   ],
   [
    "sg_fn"
   ]
  ]
 },
